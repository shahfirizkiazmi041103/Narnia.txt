<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5D6A1">

    <ImageView
        android:id="@+id/Logo"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:src="@drawable/logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <!-- Pengaduan Button -->
    <Button
        android:id="@+id/btn_Pengaduan"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Pengaduan"
        app:layout_constraintTop_toBottomOf="@+id/Logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="#6D3D2F"
        android:textColor="#FFFFFF"
        android:layout_marginTop="15dp" />

    <!-- Informasi Button -->
    <Button
        android:id="@+id/btnInformasi"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Informasi"
        app:layout_constraintTop_toBottomOf="@id/btn_Pengaduan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="#6D3D2F"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp" />

    <!-- Lihat Lpaporan Button -->
    <Button
        android:id="@+id/btnLihatLaporan"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Lihat Laporan"
        app:layout_constraintTop_toBottomOf="@id/btnInformasi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="#6D3D2F"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp" />
    <Button
        android:id="@+id/btnOpenMap"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Maps"
        app:layout_constraintTop_toBottomOf="@id/btnLihatLaporan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="#6D3D2F"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp"/>



    <!-- Logout Button -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:text="Logout"
        app:layout_constraintTop_toBottomOf="@id/btnOpenMap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="#6D3D2F"
        android:textColor="#FFFFFF"
        android:layout_marginTop="10dp" />



</androidx.constraintlayout.widget.ConstraintLayout>
